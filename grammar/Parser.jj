PARSER_BEGIN(Parser)
package parser;

import ast.*;

public class Parser {}

PARSER_END(Parser)

SKIP:
{
    " "
  | "\t"
  | "\n"
  | "\r"
  | <"%" (~["\n","\r"])* ("\n"|"\r")>
}

TOKEN:
{
      <LPAR    : "(">
    | <RPAR    : ")">
    | <INTEGER : ("-")? (["0"-"9"])+>
    | <LAMBDA  : "lambda">
    | <LET     : "let">
    | <ADD     : "+">
    | <SYMBOL  : (["a"-"z", "A"-"Z"])*>
}

TOKEN:
{
    <ERROR : ~[]>
}

ASTNode atom():
{
    Token token;
    ASTNode node;
}
{
    (
      token = <INTEGER> { node = new IntegerNode(token.image); }
    | token = <SYMBOL>  { node = new SymbolNode(token.image); }
    )
    {
        return node;
    }
}

ASTNode list():
{
    ASTNode  node = null, t;
}
{ 
    (
    (
        <LPAR>
        (
              node = list()
            | node = add()
            | node = let()    
            | node = lambda() 
            | node = atom()   
        )*
        <RPAR>
    )
    | <EOF>
    )
  { return node; }
}

ASTNode add():
{
    ASTNode node,
            lhs,
            rhs;
}
{
    <ADD>
    (
    (
      lhs = list()
    | lhs = atom()
    )
    (
      rhs = list()
    | rhs = atom()
    )
    )
    {
        return new AdditionNode(lhs, rhs);
    }
}

ASTNode let():
{
    ASTNode node,
            bindings = new ListNode(),
            body,
            t;
}
{
    <LET>
    <LPAR>
    (
        t = binding() { bindings.addChild(t); }
    )*
    <RPAR>
    (
        body = list()
      | body = atom()
    )
    {
        return new LetNode(bindings, body);
    }
}

ASTNode binding():
{
    ASTNode node = new ListNode(),
            expr;
    Token   token;
}
{
    <LPAR>
    token = <SYMBOL> { node.addChild(new SymbolNode(token.image)); }
    (
        expr = list()
      | expr = atom()
    )
    {
        node.addChild(expr);
    }
    <RPAR>
    {
        return node;
    }
}

ASTNode lambda():
{
    ASTNode t,
            params,
            body = null;
}
{
    <LAMBDA>
    params  = list()
    (
        t = list()
        {
            if (body == null)
                body = new ListNode();
            body.addChild(t);
        }
      | t = atom()
        {
            body = t;
        }
    )
    {
        return new LambdaNode(params, body);
    }
}
